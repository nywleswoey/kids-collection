{
  "name": "kids-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "pg:up": "docker compose -f tests-pg/docker-compose.yml -p kc-pgtest up -d && until pg_isready -h localhost -p 5499 -U postgres -q; do sleep 0.5; done && for f in $(ls src/db/migrations/*.sql | sort); do PGPASSWORD=postgres psql -q -h localhost -p 5499 -U postgres -d main -v ON_ERROR_STOP=1 -f \"$f\"; done",
    "pg:down": "docker compose -f tests-pg/docker-compose.yml -p kc-pgtest down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed/index.ts",
    "reconcile": "tsx --env-file-if-exists=.env.local scripts/reconcile/index.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/blob": "^0.27.0",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "posthog-js": "^1.181.0",
    "posthog-node": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.28.1",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
