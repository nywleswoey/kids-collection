# Copy to .env.local (or use `vercel env pull .env.local`). Never commit real secrets.

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Postgres (Neon — Vercel Marketplace)
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Vercel Blob (card images)
BLOB_READ_WRITE_TOKEN=""

# Auth (U2 — Google OAuth via Auth.js)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Allowlisted parent email(s), comma-separated
PARENT_EMAILS="parent@example.com"
# Admin passcode (U4-FR1) — gates all /admin/* on top of parent sign-in.
# Server-only; never shipped to the client. Gate cookie is signed with AUTH_SECRET.
#
# DEPRECATED — cutover fallback only. Passkeys replaced this as the admin gate
# (parent-gate-auth). It ships in deploy 1 so the passkey flow can be verified
# against production, then deploy 2 deletes both the variable and its code.
ADMIN_PASSCODE=""
# WebAuthn Relying Party ID for the admin gate — the EXACT hostname passkeys bind
# to. Production: kids-collection.vercel.app. Defaults to "localhost" when unset,
# which is what local dev wants. Any request on a different host (e.g. a Vercel
# preview deployment) has no passkey path at all and falls back to Google re-auth.
WEBAUTHN_RP_ID=""
# --- Image providers (seed-time only — never set these in the deployed app) ---
#
# Map #61 / ticket #65. Every one of these is a FREE tier on an account with NO
# PAYMENT METHOD ATTACHED. That account state is the entire $0 guarantee (#68);
# there is no budget check or quota tripwire anywhere in the code, deliberately.
# Adding a card to any of these accounts silently converts a refused request
# into an invoice. `seed/NEW-THEME-RUNBOOK.md` forbids it on the *Never* list.
#
# The lane set is CODE (src/features/pool/providers/index.ts), not key presence
# (#67). An unconfigured provider ABORTS `pnpm seed --review` at startup naming
# the missing variable, rather than dropping out of the bake-off — a lane that is
# silently absent from a comparison reads as a provider that drew badly. To run
# with fewer lanes on purpose, say so:
#   pnpm seed --review --providers=pollinations
#
# `pnpm test:providers` proves a key: it runs the shared ImageProvider contract
# against the live endpoints, skipping whichever providers you have no key for.
# Deliberately out of CI (#67) — live calls would spend quota on every push.
#
# Cloudflare Workers AI — SDXL. Use a DEDICATED, single-purpose Cloudflare
# account: on a Free plan exceeding the 10,000 neurons/day allocation refuses
# the request, but on an account that pays for anything unrelated (a domain,
# Pro, Workers Paid) the same overage bills at $0.011/1k neurons. The API token
# needs `Workers AI - Read` and `Workers AI - Edit`, nothing else.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Pollinations — NO CREDENTIAL, and none is possible. Measured after #65 issued
# keys: auth.pollinations.ai is NXDOMAIN, the free Seed/Flower/Nectar tiers are
# gone, and every image model on gen.pollinations.ai is priced in prepaid Pollen
# (flux at 0.002) — an authenticated request against a zero balance returns
# 402 PAYMENT_REQUIRED. Buying credit needs a card, which #72 forbids and #68
# made structural. So the adapter runs ANONYMOUS on the legacy
# image.pollinations.ai host and sends no token, pacing at concurrency 1 with a
# 15s interval because a second concurrent request returns 429 "Queue full for
# IP" — a serial cap, not a rate.
#
# Nothing in the code reads POLLINATIONS_TOKEN. It is left here only as a record
# of the key #65 issued; setting it changes nothing. Do not restore a token path
# without re-measuring the endpoint first.
POLLINATIONS_TOKEN=""
# AI Horde — pseudonymous account (aihorde.net/register, submit a display name
# WITHOUT signing in with Google/Discord/GitHub). The key is unrecoverable if
# lost, so store it in a password manager the moment it is issued. AI Horde has
# no payment surface at all, so $0 is structural here rather than a policy.
# An escape hatch, not a bake-off lane (#71) — the pipeline does not fan out to
# it. AIHORDE_MODEL pins an SDXL-baseline model, which is what makes 768x768 a
# guarantee rather than a coin-flip against live queue depth; #74 picks it.
AIHORDE_API_KEY=""
AIHORDE_MODEL=""

# Only for local production runs (`next start`). `next dev` and Vercel trust the
# host automatically; do not set this on a self-hosted deploy behind an untrusted proxy.
AUTH_TRUST_HOST=true
